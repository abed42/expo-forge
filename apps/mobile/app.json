{
	"expo": {
		"name": "Expo Forge",
		"slug": "expo-forge-demo",
		"version": "1.0.0",
		"orientation": "portrait",
		"scheme": "expoforge",
		"userInterfaceStyle": "automatic",
		"experiments": {
			"typedRoutes": true,
			"tsconfigPaths": true
		},
		"plugins": [
			"@clerk/expo",
			"expo-secure-store",
			"expo-router",
			"expo-system-ui",
			[
				"expo-build-properties",
				{
					"ios": {
						"deploymentTarget": "17.0",
						"usePrecompiledModules": false
					}
				}
			],
			"expo-maps",
			"expo-image",
			[
				"expo-camera",
				{
					"cameraPermission": "Allow $(PRODUCT_NAME) to take photos for the chat."
				}
			],
			[
				"expo-media-library",
				{
					"photosPermission": "Allow $(PRODUCT_NAME) to show your photos in the chat attachment picker.",
					"savePhotosPermission": false,
					"isAccessMediaLocationEnabled": false,
					"granularPermissions": ["photo"]
				}
			]
		],
		"ios": {
			"bundleIdentifier": "com.example.expo-forge-demo",
			"icon": {
				"light": "./assets/images/icon/icon-light.png",
				"dark": "./assets/images/icon/icon-dark.png",
				"tinted": "./assets/images/icon/icon-tinted.png"
			}
		},
		"icon": "./assets/images/icon/icon-light.png",
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/icon/icon-android-foreground.png",
				"monochromeImage": "./assets/images/icon/icon-android-monochrome.png",
				"backgroundColor": "#FFFFFF"
			},
			"package": "com.example.expoforgedemo",
			"permissions": ["android.permission.CAMERA"]
		}
	}
}
